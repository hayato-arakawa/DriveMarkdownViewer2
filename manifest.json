{
  "manifest_version": 3,
  "name": "Drive Markdown Viewer",
  "version": "1.0.0",
  "description": "Google Driveのプレビュー画面上でMarkdownファイルを綺麗にレンダリングする拡張機能です。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/purify.min.js",
        "lib/highlight.min.js",
        "content.js"
      ],
      "css": [
        "lib/github-dark.min.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*"
  ]
}
